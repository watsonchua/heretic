/sources/
/data/
/manifest.json
/.venv/
/__pycache__/

# Embedding cache: 55 MB and fully regenerable by select_cores.py.
/embeddings.json

# Per-model evaluation output. Accumulates one file per model per run.
/results/

# Artefacts carrying verbatim source prompt text. Excluded for the same reason /sources/ and
# /data/ are: this package does not have redistribution rights for all its upstream sources
# (see METHODOLOGY.md, Licences). All are regenerable from pinned revisions.
/cores.jsonl
/selected.mitre.jsonl
/screened/
# Exclude the CONTENTS, not the directory: git does not descend into an excluded directory,
# so a negation inside one never takes effect.
/calibration/*
# The calibration reports are pure statistics and are the evidence for every threshold in the
# gates. No prompt text, so the redistribution concern does not apply to them.
!/calibration/human_harm.json
!/calibration/report.json

# Gate answer cache, regenerable.
/gates.cache.json
/export/
/export.cache.json
/pool.cache.json
/harmful_pool.jsonl
/control_pool.jsonl
